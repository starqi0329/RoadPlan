{
  "name": "roadplan",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "lint": "eslint src && prettier --check \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.mjs\"",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.mjs\"",
    "test": "vitest run",
    "rust:test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "rust:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "rust:clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "bindings": "cargo test --manifest-path src-tauri/Cargo.toml --lib bindings_export::writes_typescript_bindings -- --exact",
    "ownership": "node scripts/check-ownership.mjs",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm rust:fmt && pnpm rust:clippy && pnpm rust:test && pnpm ownership",
    "prepare": "node scripts/install-hooks.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.2",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^8.0.16",
    "vitest": "^4.0.8"
  }
}
